{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vue",
  "devCommand": "pnpm run dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "pnpm install",
  
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 3nbf4.com monetag.com cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: wss: blob:; media-src 'self' https: blob:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  
  "env": [
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_MONETAG_SITE_ID",
    "VITE_MONETAG_ENABLED",
    "VITE_LARAFLY_DOMAIN",
    "VITE_LARAFLY_ZONE_ID",
    "VITE_LARAFLY_ENABLED",
    "VITE_TRACKING_DOMAIN",
    "VITE_CUSTOM_TRACKING_ENABLED",
    "VITE_IP_API_ENABLED",
    "VITE_ANTI_BOT_ENABLED",
    "VITE_BLOCK_VPN",
    "VITE_BLOCK_DATACENTER",
    "VITE_TRACKING_ENABLED"
  ]
}
