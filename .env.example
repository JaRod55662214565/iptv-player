# ═══════════════════════════════════════════════════════════════
# Web TV — Configuration complète
# ═══════════════════════════════════════════════════════════════
# Copier ce fichier en .env et remplir les valeurs.

# ─── Secrets (requis) ─────────────────────────────────────────
# Telegram Bot : créer via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID Telegram (plusieurs séparés par virgule pour multi-admin)
TELEGRAM_CHAT_ID=

# Mot de passe admin (min 8 caractères, requis pour /panel et API)
ADMIN_PASSWORD=

# ─── Stripe ────────────────────────────────────────────────────
# Stripe activé (true = paywall visible, false = pas de popup Stripe)
STRIPE_ENABLED=false

# Stripe : clé secrète serveur (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=

# Stripe : secret du webhook (whsec_...) pour vérifier les paiements
STRIPE_WEBHOOK_SECRET=

# ─── Telegram ──────────────────────────────────────────────────
# Secret token optionnel pour sécuriser le webhook (32+ char.)
# Générer avec : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# URL publique pour le webhook Telegram (généralement identique à SITE_URL)
WEBHOOK_URL=

# ─── Site ──────────────────────────────────────────────────────
# Port du serveur (défaut: 3001)
PORT=3001

# URL publique du site (utilisée pour les liens dans Telegram et Stripe)
SITE_URL=https://votre-domaine.com

# ─── Panel Admin ───────────────────────────────────────────────
# Panel admin activé (true = panel accessible, false = panel caché)
PANEL_ENABLED=true

# ─── Playlists ─────────────────────────────────────────────────
# Playlist M3U activée (true = lien M3U disponible, false = lien masqué)
M3U_ENABLED=true

# Lien VLC activé (true = lien de partage disponible, false = lien masqué)
VLC_ENABLED=true

# Playlist M3U : authentification Basic (optionnel)
# Si défini, l'URL /api/playlist.m3u requiert ces identifiants
# IPTV Smarters Pro : http://user:pass@votre-domaine.com/api/playlist.m3u
PLAYLIST_USER=
PLAYLIST_PASSWORD=

# ─── Proxy / Rate-limiting ────────────────────────────────────
# Max requêtes proxy par minute/IP (défaut: 100)
PROXY_RATE_LIMIT=100

# Taille max du body proxy en MB (défaut: 50)
PROXY_BODY_SIZE_LIMIT_MB=50

# Ports autorisés pour le proxy (défaut: 80,443 | * = tous)
PROXY_ALLOWED_PORTS=80,443

# Max requêtes tracking par minute/IP (défaut: 60)
TRACKING_RATE_LIMIT=60

# Max tentatives captcha par minute/IP (défaut: 10)
CAPTCHA_RATE_LIMIT=10

# Max requêtes Stripe checkout par minute/IP (défaut: 5)
STRIPE_RATE_LIMIT=5

# ─── Client (Vite) ─────────────────────────────────────────────
# Monetag : monétisation par pop-ads
VITE_MONETAG_SITE_ID=
VITE_MONETAG_ENABLED=false

# Popunder : script publicitaire direct (ex: Monetag)
VITE_POPUNDER_SRC=
VITE_POPUNDER_ZONE=

# IP API — timeout en ms (défaut: 5000)
VITE_IP_API_TIMEOUT=5000
