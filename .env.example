# ─── Web TV — Configuration ─────────────────────────────────────

# ─── Variables d'environnement (production Node.js) ─────────────
# Relay Telegram local (server.js) — requis en production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mot de passe du panneau d'administration
ADMIN_PASSWORD=

# Stripe API Keys (test or live keys)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Ports (valeurs par défaut)
PORT=5173
RELAY_PORT=3001
