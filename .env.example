# ═══════════════════════════════════════════════════════════════
# Web TV — Configuration complète
# ═══════════════════════════════════════════════════════════════

# ─── Serveur (server.js) ───────────────────────────────────────
# Telegram Bot : créer via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Panel admin : mot de passe pour /panel
ADMIN_PASSWORD=

# Stripe : clé secrète serveur (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=

# Stripe : secret du webhook (whsec_...) pour vérifier les paiements
STRIPE_WEBHOOK_SECRET=

# Telegram : secret token optionnel pour sécuriser le webhook (32+ char.)
# Générer avec : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Port du relay (défaut: 3001)
PORT=3001

# URL publique du site (utilisée pour les liens dans Telegram et Stripe)
SITE_URL=https://votre-domaine.com

# URL publique pour le webhook Telegram (généralement identique à SITE_URL)
WEBHOOK_URL=https://votre-domaine.com

# ─── Client (Vite) ─────────────────────────────────────────────
# Stripe : clé publique (pk_test_... ou pk_live_...)
VITE_STRIPE_PUBLIC_KEY=

# Tracking IP des visiteurs (true/false)
VITE_TRACKING_ENABLED=true

# Anti-bot : blocage VPN/Proxy/Datacenter (true/false)
VITE_ANTI_BOT_ENABLED=true
VITE_BLOCK_VPN=true
VITE_BLOCK_DATACENTER=true

# Monetag : monétisation par pop-ads
VITE_MONETAG_SITE_ID=
VITE_MONETAG_ENABLED=false

# Popunder : script publicitaire direct (ex: Larafly/Monetag tag)
VITE_POPUNDER_SRC=https://quge5.com/88/tag.min.js
VITE_POPUNDER_ZONE=256724

# Larafly : monétisation par service worker
VITE_LARAFLY_DOMAIN=3nbf4.com
VITE_LARAFLY_ZONE_ID=11244621
VITE_LARAFLY_ENABLED=false

# Analytics personnalisé
VITE_CUSTOM_TRACKING_ENABLED=false
VITE_TRACKING_DOMAIN=votre-domaine.com

# IP API
VITE_IP_API_ENABLED=true
VITE_IP_API_TIMEOUT=5000

# Supabase (optionnel, désactivé par défaut)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
